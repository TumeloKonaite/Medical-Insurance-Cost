# Placeholder values only. Copy to .env and keep the real file out of Git.
# Use the pooled connection string shown in the Neon dashboard. TLS is enforced
# by the application even when sslmode is omitted.
DATABASE_URL=postgresql://<role>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<database>?sslmode=require

# Comma-separated, explicit browser origins. Add Vercel preview origins one by one.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://medical-insurance-cost.vercel.app

# Used only by monitoring commands and the scheduled exporter. Missing values do
# not affect API startup or prediction serving.
ARIZE_API_KEY=<arize-api-key>
ARIZE_SPACE_ID=<arize-space-id>
ARIZE_MODEL_NAME=medical-insurance-cost
ARIZE_EXPORT_BATCH_SIZE=500
ARIZE_CLAIM_STALE_MINUTES=30
ARIZE_RETRY_BASE_SECONDS=60
ARIZE_RETRY_MAX_SECONDS=3600

ENABLE_MLFLOW_TRACKING=true
ENABLE_MODEL_REGISTRATION=true
MLFLOW_TRACKING_URI=https://dagshub.com/<username>/<repository>.mlflow
MLFLOW_TRACKING_USERNAME=<dagshub-username>
MLFLOW_TRACKING_PASSWORD=<dagshub-access-token>
MLFLOW_EXPERIMENT_NAME=medical-insurance-cost
MLFLOW_REGISTERED_MODEL_NAME=medical-insurance-cost
